{
  "name": "all-search",
  "version": "1.5.10",
  "keywords": [
    "tamperMonkey",
    "user-script",
    "tool",
    "web",
    "javascript",
    "vue3"
  ],
  "description": "A top fixed menu that allows you to jump between various search engines, build based on Vue, and use rollup.",
  "author": "endday",
  "homepage": "https://github.com/all-search/all-search",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git@github.com:all-search/all-search.git"
  },
  "files": [
    "dist",
    "lib"
  ],
  "unpkg": "dist/index.user.js",
  "jsdelivr": "dist/index.user.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --ext .js,.ts,.vue src packages --fix",
    "type-check": "vue-tsc --noEmit",
    "prepare": "husky install",
    "dev:script": "pnpm run -C packages/script dev",
    "build:script": "pnpm run -C packages/script build",
    "dev:plugin": "pnpm run -C packages/plugin dev",
    "build:plugin": "pnpm run -C packages/plugin zip",
    "dev:options": "pnpm run -C packages/options dev",
    "build:options": "pnpm run -C packages/options build",
    "test:acceptance": "pnpm test && pnpm type-check && pnpm exec eslint --ext .js,.ts,.vue src packages && pnpm build:script && pnpm build:plugin && pnpm build:options"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.0.4",
    "@floating-ui/vue": "^1.1.5",
    "@wxt-dev/storage": "^1.2.6",
    "core-js": "^3.9.1",
    "element-plus": "^2.2.22",
    "jsoneditor": "^9.9.0",
    "resize-observer-polyfill": "^1.5.1",
    "vue": "^3.3.4",
    "vue-draggable-next": "^2.0.1",
    "vue-router": "^4.0.5"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.19.1",
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/compiler-sfc": "^3.0.7",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "@wxt-dev/module-vue": "^1.0.3",
    "ai-rulez": "^3.4.1",
    "autoprefixer": "^10.4.7",
    "babel-plugin-import": "^1.13.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.24.0",
    "husky": "^8.0.1",
    "jsdom": "^27.4.0",
    "lint-staged": "^13.1.0",
    "minimist": "^1.2.7",
    "postcss": "^8.4.13",
    "sass": "^1.32.8",
    "sass-loader": "^10.1.1",
    "typescript": "^5.0.0",
    "vite": "^7.3.0",
    "vite-plugin-monkey": "^7.1.8",
    "vitest": "^4.0.16",
    "vue-eslint-parser": "^9.4.2",
    "vue-tsc": "^2.0.0",
    "wxt": "^0.20.13"
  }
}
